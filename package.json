{
  "name": "digital-wallet",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @digital-wallet/frontend",
    "build": "npm run build -w @digital-wallet/frontend",
    "format": "npm run format -w @digital-wallet/frontend",
    "lint": "npm run lint -w @digital-wallet/frontend",
    "typecheck": "npm run typecheck -w @digital-wallet/frontend",
    "check-all": "npm run format && npm run lint && npm run typecheck"
  }
}