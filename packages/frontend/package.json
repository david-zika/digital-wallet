    "qrcode.vue": "3.6.0",
    "date-fns": "2.30.0",
    "bootstrap": "5.3.3",
    "vue-i18n": "9.14.2",
    "flag-icons": "7.3.2",
    "jwt-decode": "4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vue/eslint-config-typescript": "12.0.0",
    "eslint": "8.57.1",
    "eslint-plugin-vue": "9.32.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vue-tsc": "2.2.0",
    "@types/node": "20.17.16",
    "sass": "1.83.4",
    "terser": "5.37.0"
