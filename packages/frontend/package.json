{
  "name": "@digital-wallet/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "1.16.1",
    "bootstrap": "5.3.8",
    "date-fns": "4.2.1",
    "decimal.js": "10.6.0",
    "flag-icons": "7.5.0",
    "jwt-decode": "4.0.0",
    "pinia": "3.0.4",
    "qrcode.vue": "3.9.1",
    "vue": "3.5.34",
    "vue-i18n": "11.4.4",
    "vue-router": "5.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@pinia/testing": "^1.0.3",
    "@types/node": "24.12.4",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "^4.1.6",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "sass": "1.99.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^4.1.6",
    "vue-tsc": "3.3.0"
  }
}
